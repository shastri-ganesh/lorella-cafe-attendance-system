# -------------------------------------------------------------
# Lorella Speciality Cafe - Environment Configuration Template
# Copy this file to .env and customize values for your environment.
# NEVER commit your actual .env file with secrets to Git.
# -------------------------------------------------------------

# Application
APP_NAME="Lorella Speciality Cafe"
APP_ENV=production        # production | development | local
APP_DEBUG=false
APP_URL=https://attendance.lorellacafe.com
APP_KEY=change_me_to_a_secure_random_64_character_hex_secret_key
TIMEZONE="Asia/Kolkata"

# Database (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lorella_attendance
DB_USER=lorella_user
DB_PASS=replace_with_strong_database_password
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=7200    # in seconds (2 hours)
SESSION_SECURE_COOKIE=true # set false only for non-HTTPS local dev
SESSION_COOKIE_NAME=lorella_session
CSRF_COOKIE_NAME=lorella_csrf

# Rate Limiting & Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Two-Factor Authentication (TOTP)
TOTP_ISSUER="Lorella Cafe"
TOTP_WINDOW=1             # +/- 1 30-second window drift tolerance

# Storage Paths (Relative to project root or absolute)
STORAGE_PATH=storage
UPLOAD_MAX_BYTES=5242880  # 5MB in bytes
